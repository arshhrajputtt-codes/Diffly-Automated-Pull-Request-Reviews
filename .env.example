# Copy to .env and fill in real values. Never commit the actual .env file.

ENVIRONMENT=development
DEBUG=true

DATABASE_URL=sqlite:///./diffly.db

# From your GitHub App or webhook configuration — GitHub signs every
# webhook request with this, and we verify that signature on every request.
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-value

# Personal Access Token (repo scope) — Settings > Developer settings >
# Personal access tokens on GitHub. Used to fetch diffs/files and post
# review comments, as your account.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# "ollama" = free, runs locally, no key needed (default).
# "anthropic" = paid, needs ANTHROPIC_API_KEY, better review quality.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

MAX_CONTEXT_FILES=8

ALLOWED_ORIGINS=["http://localhost:5180"]
